# Merge needed values into ~/.hermes/.env; preserve its existing API_SERVER_KEY.
# Never pass API_SERVER_KEY to Flutter or commit a filled configuration file.
API_SERVER_KEY=
HERMES_APP_DEFAULT_URL=
HERMES_APP_LEGACY_URL=
HERMES_LIVE_BASE_URL=
HERMES_WEB_API=http://127.0.0.1:8642
HERMES_WEB_HOST=127.0.0.1
HERMES_WEB_PORT=8700
HERMES_PROXY_MAX_BODY=629145600
HERMES_PROXY_BIG_SLOTS=2
# Optional: HERMES_WEB_ROOT, HERMES_WEB_HOME
