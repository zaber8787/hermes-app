<?xml version="1.0" encoding="UTF-8"?>
<!-- TASK-WSBRIDGE: template only. Copy to ~/Library/LaunchAgents/, replace HOME_DIR,
     then `launchctl bootstrap gui/$(id -u) <plist>`. No script installs it. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.hermes-app.wsbridge</string>
  <key>ProgramArguments</key>
  <array>
    <string>HOME_DIR/.hermes/hermes-agent/.venv/bin/python</string>
    <string>HOME_DIR/.hermes/plugins/hermes-app-compat/wsbridge.py</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict><key>PYTHONPATH</key><string>HOME_DIR/.hermes/hermes-agent</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>HOME_DIR/.hermes/logs/wsbridge.log</string>
  <key>StandardErrorPath</key><string>HOME_DIR/.hermes/logs/wsbridge.log</string>
</dict>
</plist>
