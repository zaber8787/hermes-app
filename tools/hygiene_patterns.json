{
 "comment": "Generic shape rules + sha256 of exact known-private strings. No raw values here; add new private tokens by appending sha256(lower(value)). Shape rules (PUBLIC-AUDIT §3): email/phone/international-number forms, labelled 17-19 digit platform IDs, credential assignments with nonempty values, concrete home-user directory components. credential-value hits for exactly documented synthetic test values are skipped via allow_values below; empty values are never hits.",
 "regex": [
  {
   "id": "cgnat-ipv4",
   "pattern": "\\b100\\.(?:6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\\.\\d{1,3}\\.\\d{1,3}\\b"
  },
  {
   "id": "tailnet-domain",
   "pattern": "\\b[A-Za-z0-9._-]+\\.ts\\.net\\b"
  },
  {
   "id": "session-slug-shape",
   "pattern": "\\b\\d{8}_\\d{6}_[0-9a-f]{8}\\b"
  },
  {
   "id": "email-shape",
   "pattern": "[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+(?:\\.[A-Za-z0-9-]+)+"
  },
  {
   "id": "phone-shape",
   "pattern": "(?<![\\w.])\\+\\d{1,2}(?:[ .()\\t-]*\\d{2,4}){3,}"
  },
  {
   "id": "platform-id-labelled",
   "pattern": "(?i)\\b(?:discord|snowflake|guild|channel|webhook)(?:[ _-]?id)?s?\\b(?:[\\s_-]+(?:id|channel|guild|user|member|message|server))?\\b[ \\t:=#_-]*\\d{17,19}(?![0-9])|\\b(?:discord|snowflake)(?:[\\s_-]+(?:id|channel|guild|user|member|message|server))?\\b[ \\t:=#_-]*\\d{17,19}(?![0-9])"
  }
 ],
 "extract": [
  {
   "id": "home-user",
   "pattern": "/home/([A-Za-z0-9._-]+)",
   "group": 1
  },
  {
   "id": "windows-user-path",
   "pattern": "(?i)\\b[a-z]:[/\\\\]{1,2}users[/\\\\]+([^\\\\/\"'<>|?*\\s]+)",
   "group": 1
  },
  {
   "id": "credential-value",
   "pattern": "(?m)^[ \\t]*(?:export[ \\t]+)?[A-Z0-9_]*(?:KEY|SECRET|TOKEN|PASSWD|PASSWORD|CREDENTIAL)[A-Z0-9_]*[ \\t]*=[ \\t]*(\"[^\"\\n]*\"|'[^'\\n]*'|[^\\s#\"']+)?",
   "group": 1
  },
  {
   "id": "ipv4-exact",
   "pattern": "\\b(?:\\d{1,3}\\.){3}\\d{1,3}\\b"
  },
  {
   "id": "fqdn",
   "pattern": "\\b[A-Za-z0-9][A-Za-z0-9._-]*\\.[A-Za-z]{2,}\\b"
  },
  {
   "id": "session-slug",
   "pattern": "\\b\\d{8}_\\d{6}_[0-9a-f]{8}\\b"
  }
 ],
 "allow_values": [
